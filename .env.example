# Copia este archivo a .env (no se versiona) y ajusta los valores. Nunca subas credenciales reales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crediya_solicitudes
DB_USERNAME=crediya
DB_PASSWORD=cambia-esta-clave
SERVER_PORT=8080
# Microservicio de AUTENTICACION
AUTH_SERVICE_URL=http://localhost:8081
AUTH_SERVICE_TIMEOUT_MS=3000
# JWKS de AUTENTICACION: las claves publicas con las que se verifican los tokens
AUTH_JWKS_URI=http://localhost:8081/.well-known/jwks.json
